;;; org-museum-knowledge-test.el --- Knowledge runtime tests -*- lexical-binding: t -*-

(require 'ert)
(setq load-prefer-newer t)
(require 'org-museum)

(defmacro org-museum-knowledge-test--with-wiki (&rest body)
  `(let* ((org-museum-root-dir (make-temp-file "org-museum-knowledge-" t))
          (org-museum-knowledge--root nil)
          (org-museum-knowledge--queue nil)
          (org-museum-knowledge--analyses nil)
          (org-museum-knowledge--experiences nil)
          (org-museum-knowledge--relations nil)
          (org-museum-knowledge--active nil)
          (org-museum-knowledge--actives nil)
          (org-museum-knowledge--request-buffers nil)
          (org-museum-knowledge--request-timers nil)
          (org-museum-knowledge--batch nil)
          (org-museum-knowledge--batch-log nil)
          (org-museum-knowledge--requested-file nil)
          (org-museum-knowledge--drain nil)
          (org-museum-knowledge--paused nil)
          (org-museum-knowledge-work-mode 'assist)
          (org-museum-knowledge--persist-timer nil)
          (org-museum-knowledge--auto-timer nil)
          (org-museum--index nil))
     (unwind-protect (progn ,@body)
       (when (timerp org-museum-knowledge--persist-timer)
         (cancel-timer org-museum-knowledge--persist-timer))
       (when (timerp org-museum-knowledge--auto-timer)
         (cancel-timer org-museum-knowledge--auto-timer))
       (delete-directory org-museum-root-dir t))))

(ert-deftest org-museum-knowledge-local-backend-uses-explicit-gemma-config ()
  "The local adapter must construct its backend without an unloaded setter."
  (let ((original-require (symbol-function 'require))
        (org-museum-knowledge-local-model "google/gemma-4-e2b")
        (org-museum-knowledge-local-host "127.0.0.1:1234")
        calls)
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest args)
                 (if (memq feature '(gptel gptel-openai))
                     t (apply original-require feature args))))
              ((symbol-function 'gptel-make-openai)
               (lambda (name &rest args)
                 (push (cons name args) calls)
                 'local-backend)))
      (should (eq 'local-backend (org-museum-knowledge--local-backend)))
      (should (equal '("--noproxy" "*")
                     (plist-get (cdar calls) :curl-args)))
      (should (equal '(google/gemma-4-e2b)
                     (plist-get (cdar calls) :models)))
      (should (equal "127.0.0.1:1234"
                     (plist-get (cdar calls) :host))))))

(ert-deftest org-museum-knowledge-save-queues-without-llm-and-survives-restart ()
  (org-museum-knowledge-test--with-wiki
   (let ((file (expand-file-name "first.org" org-museum-root-dir)))
     (with-temp-file file (insert "#+TITLE: First\nA real fix.\n"))
     (with-temp-buffer
       (insert-file-contents file)
       (setq buffer-file-name file)
       (setq-local org-museum-mode t)
       (cl-letf (((symbol-function 'gptel-request)
                  (lambda (&rest _) (ert-fail "save called AI"))))
         (org-museum-knowledge--on-save)))
     (should (= 1 (length org-museum-knowledge--queue)))
     (org-museum-knowledge--persist-state)
     (setq org-museum-knowledge--root nil
           org-museum-knowledge--queue nil)
     (org-museum-knowledge--ensure)
     (should (= 1 (length org-museum-knowledge--queue)))
     (should (equal "dirty" (alist-get 'status
                                      (car org-museum-knowledge--queue))))
     (org-museum-knowledge--mark-dirty file)
     (should (= 1 (length org-museum-knowledge--queue))))))

(ert-deftest org-museum-knowledge-batch-fills-two-workers-and-cancels-late-work ()
  (org-museum-knowledge-test--with-wiki
   (let ((one (expand-file-name "one.org" org-museum-root-dir))
         (two (expand-file-name "two.org" org-museum-root-dir))
         (calls nil)
         (org-museum-knowledge-max-workers 2))
     (with-temp-file one (insert "#+TITLE: One\nOne note.\n"))
     (with-temp-file two (insert "#+TITLE: Two\nTwo note.\n"))
     (cl-letf (((symbol-function 'org-museum-knowledge--backend)
                (lambda () 'backend))
               ((symbol-function 'org-museum-knowledge--preflight-local)
                (lambda (job _hash _backend _file)
                  (push job calls))))
       (org-museum-knowledge--start-batch (list one two))
       (should (= 2 (length calls)))
       (should (= 2 (length org-museum-knowledge--actives)))
       (should (= 2 (length (alist-get 'jobs org-museum-knowledge--batch))))
       (org-museum-ai-cancel)
       (should-not org-museum-knowledge--actives)
       (should (cl-every (lambda (job) (equal "dirty" (alist-get 'status job)))
                         org-museum-knowledge--queue))))))

(ert-deftest org-museum-knowledge-batch-reuses-current-analysis ()
  (org-museum-knowledge-test--with-wiki
   (let ((file (expand-file-name "cached.org" org-museum-root-dir)))
     (with-temp-file file (insert "#+TITLE: Cached\nStable note.\n"))
     (org-museum-knowledge--ensure)
     (let ((hash (org-museum-knowledge--file-hash file)))
       (setq org-museum-knowledge--analyses
             `(((file . ,file) (hash . ,hash) (summary . "cached")))
             org-museum-knowledge--queue nil)
       (let ((batch (org-museum-knowledge--start-batch (list file))))
         (should (= 1 (alist-get 'reused batch)))
         (should (equal "ready"
                        (alist-get 'status
                                   (org-museum-knowledge--batch-public)))))))))

(ert-deftest org-museum-knowledge-batch-restarts-exhausted-queued-job ()
  "A new selected batch must not strand a job at the retry limit."
  (org-museum-knowledge-test--with-wiki
   (let ((cached (expand-file-name "cached.org" org-museum-root-dir))
         (pending (expand-file-name "pending.org" org-museum-root-dir))
         started)
     (with-temp-file cached (insert "#+TITLE: Cached\nStable note.\n"))
     (with-temp-file pending (insert "#+TITLE: Pending\nRetry note.\n"))
     (org-museum-knowledge--ensure)
     (setq org-museum-knowledge--analyses
           `(((file . ,cached)
              (hash . ,(org-museum-knowledge--file-hash cached))
              (summary . "cached"))))
     (org-museum-knowledge--mark-dirty pending)
     (let ((job (org-museum-knowledge--job pending)))
       (setf (alist-get 'attempts job) (1+ org-museum-knowledge-max-retries)
             (alist-get 'status job) "dirty")
       (cl-letf (((symbol-function 'org-museum-knowledge--backend)
                  (lambda () 'backend))
                 ((symbol-function 'org-museum-knowledge--preflight-local)
                  (lambda (item &rest _) (setq started item))))
         (org-museum-knowledge--start-batch (list cached pending))
         (should (equal pending (alist-get 'file started)))
         (should (= 0 (alist-get 'attempts job)))
         (should (equal "running" (alist-get 'status job))))))))

(ert-deftest org-museum-knowledge-selected-batch-gets-next-worker ()
  "An explicit selection runs before unrelated dirty queue entries."
  (org-museum-knowledge-test--with-wiki
   (let ((unrelated (expand-file-name "unrelated.org" org-museum-root-dir))
         (selected (expand-file-name "selected.org" org-museum-root-dir))
         (org-museum-knowledge-max-workers 1)
         started)
     (with-temp-file unrelated (insert "#+TITLE: Other\n"))
     (with-temp-file selected (insert "#+TITLE: Selected\n"))
     (org-museum-knowledge--mark-dirty unrelated)
     (org-museum-knowledge--mark-dirty selected)
     (cl-letf (((symbol-function 'org-museum-knowledge--backend)
                (lambda () 'backend))
               ((symbol-function 'org-museum-knowledge--preflight-local)
                (lambda (job &rest _)
                  (setq started (alist-get 'file job)))))
       (org-museum-knowledge--start-batch (list selected))
       (should (equal selected started))))))

(ert-deftest org-museum-knowledge-worker-limit-persists-per-wiki ()
  "Changing the worker limit does not start analysis and survives reload."
  (org-museum-knowledge-test--with-wiki
   (let ((org-museum-knowledge-max-workers 2))
     (cl-letf (((symbol-function 'org-museum-knowledge--work-next)
                (lambda () (ert-fail "Worker setting started analysis"))))
       (should (= 4 (org-museum-knowledge--set-max-workers 4))))
     (should (= 4 (alist-get 'maxWorkers
                              (alist-get 'settings
                                         (org-museum-knowledge--read-json
                                          (org-museum-knowledge--state-path))))))
     (setq org-museum-knowledge--root nil
           org-museum-knowledge-max-workers 1)
     (org-museum-knowledge--ensure)
     (should (= 4 org-museum-knowledge-max-workers)))))

(ert-deftest org-museum-knowledge-explicit-analysis-recovers-orphaned-job ()
