(ert-deftest org-museum-knowledge-failure-reminds-once-and-ranks-first ()
  (org-museum-knowledge-test--with-wiki
   (let* ((old (expand-file-name "old.org" org-museum-root-dir))
          (now (expand-file-name "now.org" org-museum-root-dir))
          (messages nil))
     (with-temp-file old (insert "#+TITLE: SQL duplicate rows\n"))
     (with-temp-file now (insert "#+TITLE: SQL duplicate rows again\n"))
     (org-museum-knowledge--ensure)
     (setq org-museum-knowledge--experiences
           `(((type . "failure-pattern") (file . ,old)
              (sourceHash . ,(org-museum-knowledge--file-hash old))
              (problem . "SQL duplicate rows") (cause . "Bag semantics")
              (wrongAttempt . "Used EXCEPT") (result . "Use EXCEPT ALL")
              (verification . "recorded-result"))))
     (should (> (org-museum-knowledge--experience-score
                 "SQL duplicate rows" (car org-museum-knowledge--experiences))
                (org-museum-knowledge--experience-score
                 "SQL duplicate rows" '((problem . "SQL duplicate rows")))))
     (with-temp-buffer
       (insert-file-contents now)
       (setq buffer-file-name now)
       (setq-local org-museum-mode t)
       (cl-letf (((symbol-function 'message)
                  (lambda (fmt &rest args)
                    (push (apply #'format fmt args) messages)))
                 ((symbol-function 'gptel-request)
                  (lambda (&rest _) (ert-fail "reminder called AI"))))
         (org-museum-knowledge--failure-reminder (current-buffer))
         (org-museum-knowledge--failure-reminder (current-buffer)))
       (should (= 1 (length messages)))
       (should (string-match-p "Used EXCEPT" (car messages))))
     (setf (alist-get 'type (car org-museum-knowledge--experiences)) nil)
     (with-temp-buffer
       (insert-file-contents now)
       (setq buffer-file-name now)
       (setq-local org-museum-mode t)
       (setq messages nil)
       (cl-letf (((symbol-function 'message)
                  (lambda (fmt &rest args)
                    (push (apply #'format fmt args) messages))))
         (org-museum-knowledge--failure-reminder (current-buffer)))
       (should (= 1 (length messages)))))))

(ert-deftest org-museum-knowledge-annotated-relations-improve-recall ()
  (org-museum-knowledge-test--with-wiki
   (let* ((source-file (expand-file-name "source.org" org-museum-root-dir))
          (target-file (expand-file-name "target.org" org-museum-root-dir))
          (source (make-org-museum-page
                   :id "source" :path source-file :title "Source"
                   :links-to '("target")
                   :relation-types '(("target" . "前置依赖"))))
          (target (make-org-museum-page
                   :id "target" :path target-file :title "Target"))
          (table (make-hash-table :test 'equal)))
     (with-temp-file source-file (insert "#+TITLE: Source\n"))
     (with-temp-file target-file (insert "#+TITLE: Target\n"))
     (puthash "source" source table)
     (puthash "target" target table)
     (setq org-museum--index (make-org-museum-index :pages table))
     (let ((relation (car (org-museum-knowledge--annotation-relations))))
       (should (equal "depends-on" (alist-get 'type relation)))
       (should (equal "org-annotation" (alist-get 'origin relation)))
       (should (= 0.95 (alist-get 'confidence relation))))
     (with-temp-buffer
       (insert-file-contents source-file)
       (setq buffer-file-name source-file)
       (org-museum-recall "unrelated query"))
     (with-current-buffer "*Org Museum 知识上下文*"
       (should (string-match-p "前置依赖" (buffer-string)))
       (should (string-match-p "Org 标注" (buffer-string)))
       (should (string-match-p "Target" (buffer-string))))
     (org-museum-relations)
     (with-current-buffer "*Org Museum 笔记关系*"
       (should (string-match-p "有效关系：1" (buffer-string)))
       (should (string-match-p "前置依赖" (buffer-string)))))))

(ert-deftest org-museum-knowledge-confirmed-relation-persists-and-stales ()
  (org-museum-knowledge-test--with-wiki
   (let* ((source-file (expand-file-name "source.org" org-museum-root-dir))
          (target-file (expand-file-name "target.org" org-museum-root-dir))
          (source (make-org-museum-page :id "source" :path source-file :title "Source"))
          (target (make-org-museum-page :id "target" :path target-file :title "Target"))
          (table (make-hash-table :test 'equal)))
     (with-temp-file source-file
       (insert "#+TITLE: Source\nEvidence for relation.\n"))
     (with-temp-file target-file (insert "#+TITLE: Target\n"))
     (puthash "source" source table)
     (puthash "target" target table)
     (setq org-museum--index (make-org-museum-index :pages table))
     (with-temp-buffer
       (insert-file-contents source-file)
       (setq buffer-file-name source-file)
       (org-mode)
       (set-buffer-modified-p nil)
       (goto-char (point-min))
       (search-forward "Evidence for relation.")
       (let ((evidence (org-museum-knowledge--evidence-at-point)))
         (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) nil)))
           (org-museum-relate-current "target" "supports" 0.8 evidence))
         (should-not org-museum-knowledge--relations)
         (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
           (org-museum-relate-current "target" "supports" 0.8 evidence))))
     (should (= 1 (length org-museum-knowledge--relations)))
     (should (org-museum-knowledge--relation-current-p
              (car org-museum-knowledge--relations)))
     (with-temp-buffer
       (insert-file-contents source-file)
       (setq buffer-file-name source-file)
       (org-museum-recall "unrelated query"))
     (with-current-buffer "*Org Museum 知识上下文*"
       (should (string-match-p "用户确认" (buffer-string)))
       (should (string-match-p "Target" (buffer-string))))
     (setq org-museum-knowledge--root nil
           org-museum-knowledge--relations nil)
     (org-museum-knowledge--ensure)
     (should (= 1 (length org-museum-knowledge--relations)))
     (with-temp-file target-file (insert "#+TITLE: Changed\n"))
     (should-not (org-museum-knowledge--effective-relations))
     (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
       (org-museum-relation-remove
        (alist-get 'id (car org-museum-knowledge--relations))))
     (should-not org-museum-knowledge--relations))))

(ert-deftest org-museum-knowledge-conflicts-are-reviewable-not-resolved ()
  (org-museum-knowledge-test--with-wiki
   (let* ((file (expand-file-name "first.org" org-museum-root-dir))
          (other (expand-file-name "second.org" org-museum-root-dir))
          (relations '(((sourcePageId . "a") (targetPageId . "b")
                        (type . "supports"))
                       ((sourcePageId . "a") (targetPageId . "b")
                        (type . "contradicts"))
                       ((sourcePageId . "a") (targetPageId . "b")
                        (type . "depends-on"))
                       ((sourcePageId . "b") (targetPageId . "a")
                        (type . "depends-on")))))
     (with-temp-file file (insert "#+TITLE: First\n"))
     (with-temp-file other (insert "#+TITLE: Second\n"))
     (org-museum-knowledge--ensure)
     (setq org-museum-knowledge--experiences
           `(((file . ,file)
              (sourceHash . ,(org-museum-knowledge--file-hash file))
              (problem . "Same problem") (result . "Fix A") (published . t))
             ((file . ,other)
              (sourceHash . ,(org-museum-knowledge--file-hash other))
              (problem . "Same problem") (result . "Fix B") (published . t))))
     (let ((kinds (mapcar #'car (org-museum-knowledge--conflicts relations))))
       (should (member 'opposed-relations kinds))
       (should (member 'circular-dependency kinds))
       (should (member 'divergent-fixes kinds)))
     (should (org-museum-knowledge--pair-conflicting-p "a" "b" relations))
     (should (equal "influences"
                    (org-museum-knowledge--relation-type-from-label "启发影响")))
     (should (equal "part-of"
                    (org-museum-knowledge--relation-type-from-label "属于")))
     (let ((table (make-hash-table :test 'equal)))
       (puthash "a" (make-org-museum-page :id "a" :path file :title "First") table)
       (puthash "b" (make-org-museum-page :id "b" :path other :title "Second") table)
       (setq org-museum--index (make-org-museum-index :pages table))
       (setq org-museum-knowledge--relations
             (mapcar (lambda (relation)
                       (append relation
                               `((sourceFile . ,(if (equal (alist-get 'sourcePageId relation) "a")
                                                    file other))
                                 (targetFile . ,(if (equal (alist-get 'targetPageId relation) "b")
                                                    other file))
                                 (sourceHash . ,(org-museum-knowledge--file-hash
                                                 (if (equal (alist-get 'sourcePageId relation) "a")
                                                     file other)))
                                 (targetHash . ,(org-museum-knowledge--file-hash
                                                 (if (equal (alist-get 'targetPageId relation) "b")
                                                     other file)))
                                 (confidence . 0.8) (origin . "user-confirmed"))))
                     relations))
       (with-temp-buffer
         (insert-file-contents file)
         (setq buffer-file-name file)
         (org-museum-recall "same problem"))
       (with-current-buffer "*Org Museum 知识上下文*"
         (should (string-match-p "待复核：同一对笔记" (buffer-string)))))
     (should (= 2 (length org-museum-knowledge--experiences))))))

(provide 'org-museum-knowledge-test)
