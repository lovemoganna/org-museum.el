(ert-deftest org-museum-knowledge-real-export-shows-only-approved-related-experience ()
  (org-museum-knowledge-test--with-wiki
   (let* ((org-museum-scan-dir "pages")
          (org-museum-pages-subdir "pages")
          (org-museum-export-dir "dist/pages")
          (org-museum-shared-export-dir "dist")
          (org-museum-open-browser-after-export nil)
          (pages (expand-file-name "pages" org-museum-root-dir))
          (first (expand-file-name "first.org" pages))
          (second (expand-file-name "second.org" pages)))
     (make-directory pages t)
     (with-temp-file first
       (insert "#+TITLE: SQL duplicate rows\n#+WIKI_ID: first\n"
               "#+CATEGORY: Test\nA confirmed fix.\n"))
     (with-temp-file second
       (insert "#+TITLE: SQL duplicate rows again\n#+WIKI_ID: second\n"
               "#+CATEGORY: Test\nNew task.\n"))
     (org-museum-knowledge--ensure)
     (setq org-museum-knowledge--experiences
           `(((file . ,first) (pageId . "first")
              (sourceHash . ,(org-museum-knowledge--file-hash first))
              (problem . "SQL duplicate rows")
              (result . "Use EXCEPT ALL")
              (wrongAttempt . "Used EXCEPT") (published . t))
             ((file . ,first) (pageId . "first")
              (sourceHash . ,(org-museum-knowledge--file-hash first))
              (problem . "Private finding")
              (result . "Do not publish") (published . nil))
             ((type . "failure-pattern") (file . ,first) (pageId . "first")
              (sourceHash . ,(org-museum-knowledge--file-hash first))
              (problem . "SQL duplicate rows again")
              (cause . "Bag semantics")
              (wrongAttempt . "Used EXCEPT")
              (result . "Use EXCEPT ALL") (scope . "DuckDB queries")
              (verification . "user-confirmed")
              (evidence . ((line . 4) (kind . "org-source")))
              (published . t))
             ((type . "failure-pattern") (file . ,first) (pageId . "first")
              (sourceHash . ,(org-museum-knowledge--file-hash first))
              (problem . "Private SQL failure")
               (cause . "Private cause") (result . "Private fix")
               (published . nil))))
     (setq org-museum-knowledge--relations
           `(((sourcePageId . "first") (targetPageId . "second")
              (sourceFile . ,first) (targetFile . ,second)
              (sourceHash . ,(org-museum-knowledge--file-hash first))
              (targetHash . ,(org-museum-knowledge--file-hash second))
              (type . "supports") (confidence . 0.8)
              (origin . "user-confirmed")
              (evidence . ((excerpt . "PRIVATE_RELATION_EVIDENCE"))))))
     (org-museum-knowledge--persist-derived)
     (org-museum-export-all)
     (let ((html (with-temp-buffer
                   (insert-file-contents
                    (org-museum--export-filename second))
                   (buffer-string))))
       (should (string-match-p "Use EXCEPT ALL" html))
       (should (string-match-p "失败模式" html))
       (should (string-match-p "Bag semantics" html))
       (should (string-match-p "相关原笔记" html))
       (should-not (string-match-p "Do not publish" html))
       (should-not (string-match-p "Private cause" html))
       (should-not (string-match-p "PRIVATE_RELATION_EVIDENCE" html))))))

(ert-deftest org-museum-knowledge-failure-evidence-and-provenance ()
  (org-museum-knowledge-test--with-wiki
   (let* ((file (expand-file-name "failure.org" org-museum-root-dir))
          (page (make-org-museum-page :id "failure" :path file :title "Failure"))
          (table (make-hash-table :test 'equal)))
     (with-temp-file file
       (insert "#+TITLE: Failure\n* Query\n#+begin_src sql\nSELECT 1;\n#+end_src\n"
               "#+RESULTS:\n: 1\n"))
     (puthash "failure" page table)
     (setq org-museum--index (make-org-museum-index :pages table))
     (with-temp-buffer
       (insert-file-contents file)
       (setq buffer-file-name file)
       (org-mode)
       (set-buffer-modified-p nil)
       (setq-local transient-mark-mode t)
       (goto-char (point-min))
       (search-forward "#+RESULTS:")
       (beginning-of-line)
       (set-mark (point))
       (forward-line 2)
       (setq mark-active t)
       (let ((evidence (org-museum-knowledge--evidence-at-point)))
         (should (equal "org-result" (alist-get 'kind evidence)))
         (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                   ((symbol-function 'org-museum--start-background-job)
                    (lambda (&rest _) nil)))
           (org-museum-record-failure evidence "Duplicate SQL rows" "Bag semantics"
                                      "Used EXCEPT" "Use EXCEPT ALL" "DuckDB queries"))))
     (let* ((item (car org-museum-knowledge--experiences))
            (evidence (alist-get 'evidence item))
            (html (org-museum-knowledge--page-html page)))
       (should (equal "failure-pattern" (alist-get 'type item)))
       (should (equal "recorded-result" (alist-get 'verification item)))
       (should (= 6 (alist-get 'line evidence)))
       (should (equal (secure-hash 'sha256 (alist-get 'excerpt evidence))
                      (alist-get 'excerptHash evidence)))
       (should (string-match-p "Bag semantics" html))
       (should (string-match-p "第 6 行" html))
       (should-not (string-match-p "SELECT 1" html)))
     (setq org-museum-knowledge--root nil
           org-museum-knowledge--experiences nil)
     (org-museum-knowledge--ensure)
     (should (equal "failure-pattern"
                    (alist-get 'type (car org-museum-knowledge--experiences))))
     (with-temp-file file (insert "#+TITLE: Changed\n"))
     (should-not (org-museum-knowledge--page-html page)))))

