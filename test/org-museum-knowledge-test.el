(ert-deftest org-museum-knowledge-explicit-analysis-waits-for-active-job ()
  (org-museum-knowledge-test--with-wiki
   (let ((first (expand-file-name "first.org" org-museum-root-dir))
         (selected (expand-file-name "selected.org" org-museum-root-dir))
         (started nil))
     (with-temp-file first (insert "#+TITLE: First\nFirst note.\n"))
     (with-temp-file selected (insert "#+TITLE: Selected\nSelected note.\n"))
     (org-museum-knowledge--mark-dirty first)
     (org-museum-knowledge--mark-dirty selected)
     (let ((first-job (org-museum-knowledge--job first)))
       (setf (alist-get 'status first-job) "running")
       (setq org-museum-knowledge--active first-job)
       (with-temp-buffer
         (setq buffer-file-name selected)
         (org-museum-analyze-current))
       (should (equal selected org-museum-knowledge--requested-file))
       (setq org-museum-knowledge--active nil)
       (setf (alist-get 'status first-job) "done")
       (cl-letf (((symbol-function 'org-museum-knowledge--backend)
                  (lambda () 'local-backend))
                 ((symbol-function 'org-museum-knowledge--preflight-local)
                  (lambda (_job _hash _backend file) (push file started))))
         (org-museum-knowledge--work-next))
       (should (equal (list selected) started))
       (should (null org-museum-knowledge--requested-file))
       (should (equal "running" (alist-get 'status
                                          (org-museum-knowledge--job selected))))
       (org-museum-ai-cancel)))))

(ert-deftest org-museum-knowledge-public-export-requires-current-confirmed-item ()
  (org-museum-knowledge-test--with-wiki
   (let* ((file (expand-file-name "first.org" org-museum-root-dir))
          (page (make-org-museum-page :id "first" :path file))
          (confirmed nil))
     (with-temp-file file (insert "#+TITLE: First\nOriginal note.\n"))
     (org-museum-knowledge--ensure)
     (setq confirmed
           `((file . ,file) (pageId . "first")
             (sourceHash . ,(org-museum-knowledge--file-hash file))
             (problem . "Same failure") (result . "Verified fix")
             (wrongAttempt . "Old workaround") (published . t)))
     (setq org-museum-knowledge--experiences
           (list (append '((problem . "Private finding") (published . nil))
                         `((file . ,file) (pageId . "first")
                           (sourceHash . ,(org-museum-knowledge--file-hash file))))
                 confirmed))
     (let ((html (org-museum-knowledge--page-html page)))
       (should (string-match-p "Verified fix" html))
       (should-not (string-match-p "Private finding" html)))
     (with-temp-file file (insert "#+TITLE: First\nChanged evidence.\n"))
     (should-not (org-museum-knowledge--page-html page)))))

(ert-deftest org-museum-knowledge-recall-finds-prior-confirmed-experience ()
  (org-museum-knowledge-test--with-wiki
   (let* ((file (expand-file-name "first.org" org-museum-root-dir))
          (page (make-org-museum-page :id "first" :path file :title "First")))
     (with-temp-file file (insert "#+TITLE: First\nSQL fix.\n"))
     (setq org-museum--index
           (make-org-museum-index
            :pages (let ((table (make-hash-table :test 'equal)))
                     (puthash "first" page table) table)))
